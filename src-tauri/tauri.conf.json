{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "My Focus",
    "version": "0.1.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "unminimize": true,
        "startDragging": true,
        "setAlwaysOnTop": true,
        "setSize": true,
        "setResizable": true,
        "setDecorations": true,
        "setPosition": true,
        "setSkipTaskbar": true,
        "center": true
      },
      "notification": {
        "all": true
      },
      "globalShortcut": {
        "all": true
      },
      "dialog": {
        "all": false,
        "save": true,
        "open": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "scope": ["$DOCUMENT/*", "$DOWNLOAD/*", "$DESKTOP/*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.github.banasa.myfocus",
      "icon": [
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "My Focus",
        "label": "main",
        "width": 48,
        "height": 48,
        "minWidth": 48,
        "minHeight": 48,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "center": true
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
